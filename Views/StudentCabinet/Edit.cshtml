@model StudentEditViewModel

<h1>Редактирование профиля</h1>

<form method="post" asp-controller="Cabinet" asp-action="Edit">
    @Html.AntiForgeryToken()
    
    <div class="form-group">
        <label asp-for="FullName">Полное имя</label>
        <input asp-for="FullName" class="form-control" />
        <span asp-validation-for="FullName" class="text-danger"></span>
    </div>
    
    <div class="form-group">
        <label asp-for="GroupName">Группа</label>
        <input asp-for="GroupName" class="form-control" />
        <span asp-validation-for="GroupName" class="text-danger"></span>
    </div>
    
    <div class="form-group">
        <label asp-for="PhotoUrl">URL фотографии</label>
        <input asp-for="PhotoUrl" class="form-control" />
        <span asp-validation-for="PhotoUrl" class="text-danger"></span>
    </div>
    
    <button type="submit" class="btn btn-primary mt-2">Сохранить</button>
    <a asp-controller="Cabinet" asp-action="Index" class="btn btn-secondary mt-2">Отмена</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}