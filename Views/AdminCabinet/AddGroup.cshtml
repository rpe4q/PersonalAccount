@model AddGroupViewModel

<div class="container d-flex align-content-center justify-content-center">
    <div class="card w-50">
        <header class="card-header">
            <h1 class="text-center">
                Регистрация группы
            </h1>
        </header>
        <form class="card-body" method="post">
            <div class="alert-danger alert" asp-validation-summary="ModelOnly"></div>

            <div class="mb-3">
                <label class="form-label" asp-for="Name"></label>
                <input class="form-control" asp-for="Name" autocomplete="off" />
                <span class="text-danger small" asp-validation-for="Name"></span>
            </div>

            <div class="mb-3">
                <label class="form-label" asp-for="ImageUrl"></label>
                <input class="form-control" asp-for="ImageUrl" autocomplete="off" />
                <span class="text-danger small" asp-validation-for="ImageUrl"></span>
            </div>

            <div class="mb-3">
                <label class="form-label" asp-for="Description"></label>
                <textarea class="form-control" asp-for="Description" autocomplete="off"></textarea>
                <span class="text-danger small" asp-validation-for="Description"></span>
            </div>

            <button class="btn btn-primary w-100" type="submit">
                Зарегистрировать
            </button>

        </form>
    </div>
</div>